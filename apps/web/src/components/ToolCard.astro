---
import { toolSlug, type Tool } from '../lib/catalog';
import {
  lmStudioInstallUrl,
  lmStudioStatus,
  lmStudioStatusLabel,
  lmStudioStatusReason,
} from '../lib/lmstudio-install';
import { withBase } from '../lib/site-path';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const slug = toolSlug(tool);
const toolHref = withBase(`tools/${slug}/`);
const installUrl = lmStudioInstallUrl(tool);
const compatibility = lmStudioStatus(tool);
const compatibilityLabel = lmStudioStatusLabel(tool);
const compatibilityReason = lmStudioStatusReason(tool);
const sourceLabel =
  tool.source.kind === 'lmstudio-hub'
    ? 'LM Studio Hub'
    : tool.source.kind === 'mcp-registry'
      ? 'MCP Registry'
      : tool.source.kind === 'community'
        ? 'Community'
        : 'Manual listing';
const searchable = [
  tool.name,
  tool.description,
  tool.type,
  sourceLabel,
  compatibilityLabel,
  compatibilityReason,
  ...tool.categories,
  ...tool.tags,
  ...tool.platforms,
  ...(tool.risks ?? []),
].join(' ').toLowerCase();
const knownRuntimeValues = [
  tool.runtime.local,
  tool.runtime.networkRequired,
  tool.runtime.apiKeyRequired,
].filter((value) => value !== 'unknown').length;
const metadataQuality =
  (tool.description.startsWith('No description provided') ? 0 : 1) +
  (tool.categories.some((category) => category !== 'uncategorized') ? 2 : 0) +
  knownRuntimeValues +
  (tool.platforms.length > 0 ? 1 : 0);
const visibleCategories = tool.categories.filter((category) => category !== 'uncategorized');
const registryTags = tool.tags.filter((tag) => !tag.startsWith('lm-studio-'));
const displayTags = visibleCategories.length > 0 ? visibleCategories : tool.type === 'mcp' ? registryTags : [];
---

<article
  class="tool-card"
  data-tool-card
  data-id={tool.id}
  data-name={tool.name.toLowerCase()}
  data-search={searchable}
  data-type={tool.type}
  data-source={tool.source.kind}
  data-category={tool.categories.join(',')}
  data-platform={tool.platforms.join(',')}
  data-compatibility={compatibility}
  data-downloads={tool.source.downloads ?? 0}
  data-likes={tool.source.likes ?? 0}
  data-updated-at={tool.source.updatedAt ?? ''}
  data-metadata-quality={metadataQuality}
>
  <div class="card-topline">
    <span class="badge">{tool.type === 'lmstudio-plugin' ? 'LM Studio Plugin' : 'MCP Server'}</span>
    <span class="badge source">{sourceLabel}</span>
    <span class:list={['badge', compatibility === 'ready' && 'good', compatibility === 'setup-required' && 'setup']}>
      {compatibilityLabel}
    </span>
    {tool.runtime.local === true && <span class="badge good">Fully local</span>}
    {tool.runtime.local === false && <span class="badge">Remote</span>}
    {tool.runtime.apiKeyRequired === false && <span class="badge good">No API key</span>}
    {(tool.risks?.length ?? 0) > 0 && <span class="badge risk">⚠ {tool.risks?.length} risk signal{tool.risks?.length === 1 ? '' : 's'}</span>}
  </div>

  <div>
    <h2><a href={toolHref}>{tool.name}</a></h2>
    <p>{tool.description}</p>
  </div>

  {displayTags.length > 0 && (
    <div class="badges">
      {displayTags.slice(0, 4).map((tag) => <span class="badge">{tag}</span>)}
    </div>
  )}

  <div class="card-spacer"></div>

  <div class="card-actions">
    {installUrl
      ? <a class="install-button" href={installUrl}>Add to LM Studio</a>
      : <span class="install-button disabled" title={compatibilityReason} aria-disabled="true">Add to LM Studio</span>}
    <a class="card-link" href={toolHref}>View details →</a>
  </div>

  <div class="card-footer">
    <span>
      {tool.setup?.version ? `v${tool.setup.version} · ` : ''}
      {typeof tool.source.downloads === 'number'
        ? `${tool.source.downloads} downloads · `
        : ''}
      by {tool.author.handle ?? tool.author.name}
    </span>
  </div>
</article>

<style>
  .tool-card {
    min-height: 260px;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .tool-card:hover {
    box-shadow: 0 14px 36px rgb(0 0 0 / 22%);
  }

  .badge.source {
    color: var(--accent);
    border-color: rgb(125 211 252 / 22%);
    background: rgb(125 211 252 / 5%);
  }

  .badge.setup {
    color: #f5d58a;
    border-color: rgb(251 191 36 / 24%);
    background: rgb(251 191 36 / 6%);
  }

  .tool-card h2 {
    line-height: 1.2;
  }

  .tool-card h2 a:hover {
    color: var(--accent);
  }

  .tool-card p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .install-button {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.65rem;
    padding: 0 0.8rem;
    background: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .install-button:hover {
    background: white;
  }

  .install-button.disabled {
    border: 1px solid var(--border);
    background: #09101a;
    color: var(--muted);
    cursor: not-allowed;
    opacity: 0.62;
  }

  .card-footer {
    justify-content: flex-start;
  }
</style>
