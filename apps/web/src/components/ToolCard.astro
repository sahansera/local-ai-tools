---
import { toolSlug, type Tool } from '../lib/catalog';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const slug = toolSlug(tool);
const sourceLabel =
  tool.source.kind === 'lmstudio-hub'
    ? 'LM Studio Hub'
    : tool.source.kind === 'mcp-registry'
      ? 'MCP Registry'
      : tool.source.kind === 'community'
        ? 'Community'
        : 'Manual listing';
const searchable = [
  tool.name,
  tool.description,
  tool.type,
  sourceLabel,
  ...tool.categories,
  ...tool.tags,
  ...tool.platforms,
  ...(tool.risks ?? []),
].join(' ').toLowerCase();
const knownRuntimeValues = [
  tool.runtime.local,
  tool.runtime.networkRequired,
  tool.runtime.apiKeyRequired,
].filter((value) => value !== 'unknown').length;
const metadataQuality =
  (tool.description.startsWith('No description provided') ? 0 : 1) +
  (tool.categories.some((category) => category !== 'uncategorized') ? 2 : 0) +
  knownRuntimeValues +
  (tool.platforms.length > 0 ? 1 : 0);
---

<article
  class="tool-card"
  data-tool-card
  data-id={tool.id}
  data-name={tool.name.toLowerCase()}
  data-search={searchable}
  data-type={tool.type}
  data-source={tool.source.kind}
  data-category={tool.categories.join(',')}
  data-platform={tool.platforms.join(',')}
  data-downloads={tool.source.downloads ?? 0}
  data-likes={tool.source.likes ?? 0}
  data-updated-at={tool.source.updatedAt ?? ''}
  data-metadata-quality={metadataQuality}
>
  <div class="card-topline">
    <span class="badge">{tool.type === 'lmstudio-plugin' ? 'LM Studio Plugin' : 'MCP Server'}</span>
    <span class="badge source">{sourceLabel}</span>
    {tool.runtime.local === true && <span class="badge good">Fully local</span>}
    {tool.runtime.apiKeyRequired === false && <span class="badge good">No API key</span>}
    {(tool.risks?.length ?? 0) > 0 && <span class="badge risk">⚠ {tool.risks?.length} risk signal{tool.risks?.length === 1 ? '' : 's'}</span>}
  </div>

  <div>
    <h2><a href={`/tools/${slug}/`}>{tool.name}</a></h2>
    <p>{tool.description}</p>
  </div>

  <div class="badges">
    {tool.categories.slice(0, 4).map((category) => <span class="badge">{category}</span>)}
  </div>

  <div class="card-spacer"></div>

  <div class="card-footer">
    <span>
      {typeof tool.source.downloads === 'number'
        ? `${tool.source.downloads} downloads · `
        : ''}
      by {tool.author.handle ?? tool.author.name}
    </span>
    <a class="card-link" href={`/tools/${slug}/`}>View tool →</a>
  </div>
</article>

<style>
  .tool-card {
    min-height: 240px;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .tool-card:hover {
    box-shadow: 0 14px 36px rgb(0 0 0 / 22%);
  }

  .tool-card h2 {
    line-height: 1.2;
  }

  .tool-card h2 a:hover {
    color: var(--accent);
  }

  .tool-card p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }
</style>
