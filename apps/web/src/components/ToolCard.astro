---
import { toolSlug, type Tool } from '../lib/catalog';
import {
  lmStudioInstallUrl,
  lmStudioStatus,
  lmStudioStatusLabel,
  lmStudioStatusReason,
} from '../lib/lmstudio-install';
import { withBase } from '../lib/site-path';
import CardActions from './CardActions.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const slug = toolSlug(tool);
const toolHref = withBase(`tools/${slug}/`);
const compatibility = lmStudioStatus(tool);
const compatibilityLabel = lmStudioStatusLabel(tool);
const compatibilityReason = lmStudioStatusReason(tool);
const sourceLabel =
  tool.source.kind === 'lmstudio-hub'
    ? 'LM Studio Hub'
    : tool.source.kind === 'mcp-registry'
      ? 'MCP Registry'
      : tool.source.kind === 'community'
        ? 'Community'
        : 'Manual listing';
const searchable = [
  tool.name,
  tool.description,
  tool.type,
  sourceLabel,
  compatibilityLabel,
  compatibilityReason,
  ...tool.categories,
  ...tool.tags,
  ...tool.platforms,
  ...(tool.risks ?? []),
].join(' ').toLowerCase();
const knownRuntimeValues = [
  tool.runtime.local,
  tool.runtime.networkRequired,
  tool.runtime.apiKeyRequired,
].filter((value) => value !== 'unknown').length;
const metadataQuality =
  (tool.description.startsWith('No description provided') ? 0 : 1) +
  (tool.categories.some((category) => category !== 'uncategorized') ? 2 : 0) +
  knownRuntimeValues +
  (tool.platforms.length > 0 ? 1 : 0);
const visibleCategories = tool.categories.filter((category) => category !== 'uncategorized');
const registryTags = tool.tags.filter((tag) => !tag.startsWith('lm-studio-'));
const displayTags = visibleCategories.length > 0 ? visibleCategories : tool.type === 'mcp' ? registryTags : [];
---

<article
  class="tool-card"
  data-tool-card
  data-id={tool.id}
  data-name={tool.name.toLowerCase()}
  data-search={searchable}
  data-type={tool.type}
  data-source={tool.source.kind}
  data-category={tool.categories.join(',')}
  data-platform={tool.platforms.join(',')}
  data-compatibility={compatibility}
  data-downloads={tool.source.downloads ?? 0}
  data-likes={tool.source.likes ?? 0}
  data-updated-at={tool.source.updatedAt ?? ''}
  data-metadata-quality={metadataQuality}
>
  <div class="card-heading">
    <span class="tool-monogram" aria-hidden="true">{tool.name.slice(0, 2).toUpperCase()}</span>
    <div class="card-kind"><span>{tool.type === 'lmstudio-plugin' ? 'LM Studio Plugin' : 'MCP Server'}</span><small>{sourceLabel}</small></div>
    <span class:list={['badge', 'compatibility-badge', compatibility === 'ready' && 'good', compatibility === 'setup-required' && 'setup']} title={compatibilityReason}>{compatibility === 'ready' ? 'Ready' : compatibilityLabel}</span>
  </div>
  <div class="card-topline" hidden={tool.runtime.local === 'unknown' && tool.runtime.apiKeyRequired !== false && !(tool.risks?.length)}>
    {tool.runtime.local === true && <span class="badge good">Fully local</span>}
    {tool.runtime.local === false && <span class="badge">Remote</span>}
    {tool.runtime.apiKeyRequired === false && <span class="badge good">No API key</span>}
    {(tool.risks?.length ?? 0) > 0 && <span class="badge risk">⚠ {tool.risks?.length} risk signal{tool.risks?.length === 1 ? '' : 's'}</span>}
  </div>

  <div>
    <h2><a href={toolHref}>{tool.name}</a></h2>
    <p>{tool.description}</p>
  </div>

  {displayTags.length > 0 && (
    <div class="badges">
      {displayTags.slice(0, 4).map((tag) => <span class="badge">{tag}</span>)}
    </div>
  )}

  <div class="card-spacer"></div>

  <div class="card-footer">
    <span class="card-meta">
      <span class="card-author">by {tool.author.handle ?? tool.author.name}</span>
      <small>{typeof tool.source.downloads === 'number' ? `${tool.source.downloads.toLocaleString('en-US')} downloads` : tool.setup?.version ? `v${tool.setup.version}` : sourceLabel}</small>
    </span>
    <CardActions name={tool.name} detailsHref={toolHref} installHref={lmStudioInstallUrl(tool)} setupRequired={compatibility === 'setup-required'} />
  </div>
</article>
