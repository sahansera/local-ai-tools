---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools, toolSlug, type RuntimeValue, type Tool } from '../../lib/catalog';
import {
  lmStudioInstallUrl,
  lmStudioStatus,
  lmStudioStatusLabel,
  lmStudioStatusReason,
} from '../../lib/lmstudio-install';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: toolSlug(tool) }, props: { tool } }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const typeLabel = tool.type === 'lmstudio-plugin' ? 'LM Studio Plugin' : 'MCP Server';
const sourceLabel =
  tool.source.kind === 'lmstudio-hub'
    ? 'LM Studio Hub'
    : tool.source.kind === 'mcp-registry'
      ? 'MCP Registry'
      : tool.source.kind === 'community'
        ? 'Community submission'
        : 'Manual listing';
const inferred = tool.source.inferred;
const hasInferredMetadata = Boolean(
  inferred?.capabilities || inferred?.runtime || inferred?.risks || inferred?.platforms,
);
const visibleCategories = tool.categories.filter((category) => category !== 'uncategorized');
const installUrl = lmStudioInstallUrl(tool);
const compatibility = lmStudioStatus(tool);
const compatibilityLabel = lmStudioStatusLabel(tool);
const compatibilityReason = lmStudioStatusReason(tool);
const configJson = tool.lmStudio?.config
  ? JSON.stringify(tool.lmStudio.config, null, 2)
  : undefined;

function yesNoUnknown(value: RuntimeValue, yes: string, no: string): string {
  if (value === true) return yes;
  if (value === false) return no;
  return 'Unknown';
}
---

<BaseLayout title={`${tool.name} — Local AI Tools`} description={tool.description}>
  <main class="site-shell detail-wrap" data-pagefind-body>
    <article class="detail-main">
      <div class="badges">
        <span class="badge" data-pagefind-filter={`type:${tool.type}`}>{typeLabel}</span>
        <span hidden data-pagefind-filter={`source:${tool.source.kind}`}>{tool.source.kind}</span>
        <span class="badge source">{sourceLabel}</span>
        <span class:list={['badge', compatibility === 'ready' && 'good', compatibility === 'setup-required' && 'setup']}>
          {compatibilityLabel}
        </span>
        {tool.runtime.local === true && <span class="badge good" data-pagefind-filter="local:true">Fully local</span>}
        {tool.runtime.local === false && <span class="badge">Remote</span>}
        {tool.runtime.apiKeyRequired === false && <span class="badge good" data-pagefind-filter="api-key:false">No API key</span>}
      </div>

      <h1 data-pagefind-meta="title">{tool.name}</h1>
      <span hidden data-pagefind-meta="toolId">{tool.id}</span>
      <p>{tool.description}</p>

      <div class="compatibility-panel">
        <div>
          <span class="compatibility-kicker">LM Studio compatibility</span>
          <h2>{compatibilityLabel}</h2>
          <p>{compatibilityReason}</p>
        </div>
        {installUrl
          ? (
            <a class="inline-install-button" href={installUrl}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 5v14M5 12h14" />
              </svg>
              <span>Add to LM Studio</span>
            </a>
          )
          : (
            <span class="inline-install-button disabled" aria-disabled="true" title={compatibilityReason}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 5v14M5 12h14" />
              </svg>
              <span>Add to LM Studio</span>
            </span>
          )}
      </div>

      {tool.type === 'mcp' && tool.lmStudio && (
        <div class="detail-section">
          <h2>LM Studio MCP configuration</h2>
          {tool.lmStudio.mode && (
            <p class="section-note">
              Connection mode: <strong>{tool.lmStudio.mode === 'stdio' ? 'Local stdio' : 'Remote HTTP'}</strong>.
            </p>
          )}

          {(tool.lmStudio.requirements?.length ?? 0) > 0 && (
            <div class="compatibility-list">
              <strong>Runtime requirements</strong>
              <ul>
                {tool.lmStudio.requirements.map((requirement) => <li>{requirement}</li>)}
              </ul>
            </div>
          )}

          {(tool.lmStudio.requiredInputs?.length ?? 0) > 0 && (
            <div class="compatibility-list">
              <strong>Values required before installation</strong>
              <ul>
                {tool.lmStudio.requiredInputs.map((input) => <li>{input}</li>)}
              </ul>
            </div>
          )}

          {configJson && (
            <div class="config-preview">
              <span>Generated LM Studio server entry</span>
              <pre><code>{configJson}</code></pre>
            </div>
          )}
        </div>
      )}

      {hasInferredMetadata && (
        <div class="metadata-note" data-pagefind-ignore>
          Some capability, runtime, or risk signals on this listing were inferred from public source metadata to improve discovery. Inferred values may be incomplete; use the upstream project or registry page as the source of truth.
        </div>
      )}

      {tool.setup && (
        <div class="detail-section">
          <h2>MCP Registry metadata</h2>
          <p class="section-note">Setup metadata below is taken directly from the official MCP Registry.</p>
          <div class="setup-grid">
            {tool.setup.version && (
              <div>
                <span>Version</span>
                <strong>v{tool.setup.version}</strong>
              </div>
            )}
            {(tool.setup.packageTypes?.length ?? 0) > 0 && (
              <div>
                <span>Packages</span>
                <div class="badges">
                  {tool.setup.packageTypes?.map((packageType) => <span class="badge">{packageType}</span>)}
                </div>
              </div>
            )}
            {(tool.setup.transports?.length ?? 0) > 0 && (
              <div>
                <span>Transports</span>
                <div class="badges">
                  {tool.setup.transports?.map((transport) => <span class="badge">{transport}</span>)}
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      <div class="detail-section">
        <h2>{inferred?.capabilities ? 'Detected capabilities' : 'Capabilities'}</h2>
        {inferred?.capabilities && (
          <p class="section-note">These capabilities were inferred from the plugin's public Hub metadata.</p>
        )}
        {visibleCategories.length > 0
          ? (
            <div class="badges">
              {visibleCategories.map((category) => <span class="badge" data-pagefind-filter={`category:${category}`}>{category}</span>)}
            </div>
          )
          : <p class="section-note">Capability classification is not available for this listing yet.</p>}
      </div>

      {tool.tags.length > 0 && (
        <div class="detail-section">
          <h2>{tool.type === 'mcp' ? 'Registry metadata' : 'Tags'}</h2>
          <div class="badges">
            {tool.tags.filter((tag) => !tag.startsWith('lm-studio-')).map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </div>
      )}

      <div class="detail-section">
        <h2>Platforms</h2>
        {inferred?.platforms && (
          <p class="section-note">Platform support was inferred from public metadata.</p>
        )}
        <div class="platforms">
          {tool.platforms.length > 0
            ? tool.platforms.map((platform) => <span class="badge" data-pagefind-filter={`platform:${platform}`}>{platform}</span>)
            : <span class="badge">Unknown</span>}
        </div>
      </div>

      {(tool.risks?.length ?? 0) > 0 && (
        <div class="detail-section">
          <h2>Detected risk signals</h2>
          <p class="section-note">These signals describe capabilities that may deserve extra review; they do not mean the tool is unsafe.</p>
          <div class="badges">
            {tool.risks?.map((risk) => <span class="badge risk">⚠ {risk}</span>)}
          </div>
        </div>
      )}
    </article>

    <aside class="detail-sidebar" data-pagefind-ignore>
      <div class="detail-row"><span>Type</span><strong>{typeLabel}</strong></div>
      <div class="detail-row"><span>Source</span><strong>{sourceLabel}</strong></div>
      <div class="detail-row"><span>LM Studio</span><strong>{compatibilityLabel}</strong></div>
      {tool.setup?.version && <div class="detail-row"><span>Version</span><strong>v{tool.setup.version}</strong></div>}
      {tool.setup?.status && <div class="detail-row"><span>Registry status</span><strong>{tool.setup.status}</strong></div>}
      <div class="detail-row">
        <span>Execution</span>
        <strong>
          {yesNoUnknown(tool.runtime.local, 'Local', 'Remote / hybrid')}
          {inferred?.runtime && tool.runtime.local !== 'unknown' && <small>Inferred</small>}
        </strong>
      </div>
      <div class="detail-row">
        <span>Network</span>
        <strong>
          {yesNoUnknown(tool.runtime.networkRequired, 'Required', 'Not required')}
          {inferred?.runtime && tool.runtime.networkRequired !== 'unknown' && <small>Inferred</small>}
        </strong>
      </div>
      <div class="detail-row">
        <span>API key</span>
        <strong>
          {yesNoUnknown(tool.runtime.apiKeyRequired, 'Required', 'Not required')}
          {inferred?.runtime && tool.runtime.apiKeyRequired !== 'unknown' && <small>Inferred</small>}
        </strong>
      </div>
      <div class="detail-row"><span>Author</span><strong>{tool.author.handle ?? tool.author.name}</strong></div>
      {typeof tool.source.downloads === 'number' && <div class="detail-row"><span>Downloads</span><strong>{tool.source.downloads}</strong></div>}
      {typeof tool.source.likes === 'number' && <div class="detail-row"><span>Likes</span><strong>{tool.source.likes}</strong></div>}
      {tool.source.updatedAt && <div class="detail-row"><span>Updated</span><strong>{new Date(tool.source.updatedAt).toLocaleDateString('en-AU')}</strong></div>}

      <a class="secondary-link" href={tool.links.homepage} rel="external">Open official page →</a>
      {tool.links.repository && <a class="secondary-link" href={tool.links.repository}>View source repository →</a>}
    </aside>
  </main>

  <style>
    .badge.source {
      color: var(--accent);
      border-color: rgb(125 211 252 / 22%);
      background: rgb(125 211 252 / 5%);
    }

    .badge.setup {
      color: #f5d58a;
      border-color: rgb(251 191 36 / 24%);
      background: rgb(251 191 36 / 6%);
    }

    .compatibility-panel {
      display: flex;
      max-width: 760px;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      margin-top: 1.5rem;
      border: 1px solid rgb(139 92 246 / 26%);
      border-radius: 1rem;
      padding: 1rem;
      background: linear-gradient(135deg, rgb(124 58 237 / 8%), rgb(91 92 246 / 4%));
    }

    .compatibility-panel h2 {
      margin: 0.2rem 0 0.35rem;
      font-size: 1.1rem;
    }

    .compatibility-panel p {
      margin: 0;
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    .compatibility-kicker,
    .config-preview > span {
      color: #a78bfa;
      font-size: 0.72rem;
      font-weight: 750;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .inline-install-button {
      display: inline-flex;
      flex: 0 0 auto;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.78rem;
      padding: 0 1rem;
      background: linear-gradient(135deg, #7c3aed, #5b5cf6);
      box-shadow: 0 10px 28px rgb(124 58 237 / 24%);
      color: white;
      font-size: 0.82rem;
      font-weight: 800;
      text-decoration: none;
      transition:
        transform 150ms ease,
        box-shadow 150ms ease,
        filter 150ms ease;
    }

    .inline-install-button:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 34px rgb(124 58 237 / 32%);
      filter: brightness(1.06);
    }

    .inline-install-button svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2.2;
    }

    .inline-install-button.disabled {
      border: 1px solid var(--border);
      background: #09101a;
      box-shadow: none;
      color: var(--muted);
      cursor: not-allowed;
      opacity: 0.65;
    }

    .inline-install-button.disabled:hover {
      transform: none;
      box-shadow: none;
      filter: none;
    }

    .compatibility-list {
      max-width: 760px;
      margin-top: 1rem;
      color: var(--muted);
      font-size: 0.88rem;
    }

    .compatibility-list ul {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }

    .config-preview {
      max-width: 760px;
      margin-top: 1rem;
    }

    .config-preview pre {
      overflow-x: auto;
      margin: 0.55rem 0 0;
      border: 1px solid var(--border);
      border-radius: 0.8rem;
      padding: 1rem;
      background: #070b12;
      color: var(--text);
      font-size: 0.8rem;
      line-height: 1.55;
    }

    .metadata-note {
      max-width: 760px;
      margin-top: 1.4rem;
      border: 1px solid rgb(125 211 252 / 18%);
      border-radius: 0.85rem;
      padding: 0.85rem 1rem;
      color: var(--muted);
      background: rgb(125 211 252 / 4%);
      font-size: 0.86rem;
      line-height: 1.6;
    }

    .setup-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
    }

    .setup-grid > div {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .setup-grid > div > span {
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .detail-row strong {
      display: inline-flex;
      align-items: flex-end;
      flex-direction: column;
      gap: 0.15rem;
    }

    .detail-row small {
      color: var(--muted);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    @media (max-width: 700px) {
      .compatibility-panel {
        align-items: stretch;
        flex-direction: column;
      }

      .inline-install-button {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
