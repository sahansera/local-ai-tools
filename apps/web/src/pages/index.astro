---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { categories, curatedCount, hubDiscoveryCount, platforms, tools } from '../lib/catalog';
---

<BaseLayout>
  <main>
    <section class="site-shell hero">
      <div class="eyebrow">Open-source local AI discovery</div>
      <h1>Find the right tools for your local AI.</h1>
      <p>
        Discover LM Studio-compatible plugins and MCP servers by capability, runtime, platform, and setup requirements.
      </p>
    </section>

    <section class="site-shell marketplace-panel" id="tools" aria-labelledby="tools-heading">
      <div class="filters">
        <input class="search-input" id="tool-search" type="search" placeholder="Search video, files, coding…" aria-label="Search tools" />

        <select class="filter-select" id="type-filter" aria-label="Filter by type">
          <option value="">All types</option>
          <option value="lmstudio-plugin">LM Studio plugins</option>
          <option value="mcp">MCP servers</option>
        </select>

        <select class="filter-select" id="source-filter" aria-label="Filter by source">
          <option value="">All sources</option>
          <option value="curated">Curated</option>
          <option value="hub-discovery">Hub discoveries</option>
        </select>

        <select class="filter-select" id="category-filter" aria-label="Filter by category">
          <option value="">All categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>

        <select class="filter-select" id="platform-filter" aria-label="Filter by platform">
          <option value="">All platforms</option>
          {platforms.map((platform) => <option value={platform}>{platform}</option>)}
        </select>
      </div>

      <div class="marketplace-meta">
        <div>
          <strong id="tools-heading">Browse tools</strong>
          <span class="source-summary">{curatedCount} curated · {hubDiscoveryCount} Hub discoveries</span>
        </div>
        <div class="marketplace-actions">
          <span id="result-count">{tools.length} {tools.length === 1 ? 'tool' : 'tools'}</span>
          <select class="filter-select sort-select" id="sort-filter" aria-label="Sort tools">
            <option value="recommended">Recommended</option>
            <option value="popular">Popular</option>
            <option value="recent">Recently updated</option>
            <option value="name">Name A–Z</option>
          </select>
        </div>
      </div>

      {hubDiscoveryCount > 0 && (
        <div class="discovery-banner">
          Hub discoveries are automatically sourced from LM Studio and may contain inferred metadata. Use the source filter to show only curated listings.
        </div>
      )}

      <div class="tool-grid" id="tool-grid">
        {tools.map((tool) => <ToolCard tool={tool} />)}
      </div>

      <div class="empty-state" id="empty-state">
        No tools match those filters yet. Try a broader search.
      </div>
    </section>
  </main>

  <script type="module" is:inline>
    const searchInput = document.querySelector('#tool-search');
    const typeFilter = document.querySelector('#type-filter');
    const sourceFilter = document.querySelector('#source-filter');
    const categoryFilter = document.querySelector('#category-filter');
    const platformFilter = document.querySelector('#platform-filter');
    const sortFilter = document.querySelector('#sort-filter');
    const cards = [...document.querySelectorAll('[data-tool-card]')];
    const originalOrder = new Map(cards.map((card, index) => [card, index]));
    const count = document.querySelector('#result-count');
    const empty = document.querySelector('#empty-state');
    const grid = document.querySelector('#tool-grid');

    let pagefind = null;
    try {
      const pagefindUrl = new URL('_pagefind/pagefind.js', document.baseURI).href;
      pagefind = await import(pagefindUrl);
      await pagefind.init?.();
    } catch {
      // Pagefind is created after production builds. Local filtering keeps dev usable.
    }

    const values = () => ({
      query: searchInput.value.trim().toLowerCase(),
      type: typeFilter.value,
      source: sourceFilter.value,
      category: categoryFilter.value,
      platform: platformFilter.value,
    });

    const localMatches = (card, filters) => {
      const categories = card.dataset.category.split(',').filter(Boolean);
      const platforms = card.dataset.platform.split(',').filter(Boolean);
      return (
        (!filters.query || card.dataset.search.includes(filters.query)) &&
        (!filters.type || card.dataset.type === filters.type) &&
        (!filters.source || card.dataset.source === filters.source) &&
        (!filters.category || categories.includes(filters.category)) &&
        (!filters.platform || platforms.includes(filters.platform))
      );
    };

    const numeric = (value) => Number(value || 0);
    const updatedAt = (card) => Date.parse(card.dataset.updatedAt || '') || 0;
    const byName = (a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || '');

    const compareCards = (a, b) => {
      const mode = sortFilter.value;

      if (mode === 'name') return byName(a, b);

      if (mode === 'recent') {
        return (
          updatedAt(b) - updatedAt(a) ||
          numeric(b.dataset.downloads) - numeric(a.dataset.downloads) ||
          byName(a, b)
        );
      }

      if (mode === 'popular') {
        return (
          numeric(b.dataset.downloads) - numeric(a.dataset.downloads) ||
          numeric(b.dataset.likes) - numeric(a.dataset.likes) ||
          byName(a, b)
        );
      }

      const curatedA = a.dataset.source === 'curated' ? 1 : 0;
      const curatedB = b.dataset.source === 'curated' ? 1 : 0;
      return (
        curatedB - curatedA ||
        numeric(b.dataset.downloads) - numeric(a.dataset.downloads) ||
        numeric(b.dataset.likes) - numeric(a.dataset.likes) ||
        updatedAt(b) - updatedAt(a) ||
        originalOrder.get(a) - originalOrder.get(b)
      );
    };

    const applySort = () => {
      [...cards].sort(compareCards).forEach((card) => grid.append(card));
    };

    async function applyFilters() {
      const filters = values();
      let matchingIds = null;

      if (pagefind) {
        const pagefindFilters = {};
        if (filters.type) pagefindFilters.type = filters.type;
        if (filters.source) pagefindFilters.source = filters.source;
        if (filters.category) pagefindFilters.category = filters.category;
        if (filters.platform) pagefindFilters.platform = filters.platform;

        try {
          const result = await pagefind.search(filters.query || null, { filters: pagefindFilters });
          const resultData = await Promise.all(result.results.map((item) => item.data()));
          matchingIds = new Set(resultData.map((item) => item.meta.toolId).filter(Boolean));
        } catch {
          matchingIds = null;
        }
      }

      let visible = 0;
      for (const card of cards) {
        const show = matchingIds ? matchingIds.has(card.dataset.id) : localMatches(card, filters);
        card.hidden = !show;
        if (show) visible += 1;
      }

      applySort();
      count.textContent = `${visible} ${visible === 1 ? 'tool' : 'tools'}`;
      empty.style.display = visible ? 'none' : 'block';
      grid.style.display = visible ? 'grid' : 'none';
    }

    for (const control of [searchInput, typeFilter, sourceFilter, categoryFilter, platformFilter]) {
      control.addEventListener(control === searchInput ? 'input' : 'change', applyFilters);
    }

    sortFilter.addEventListener('change', applySort);
    applySort();
  </script>

  <style>
    .marketplace-actions {
      justify-content: flex-end;
    }

    .sort-select {
      width: auto;
      min-width: 165px;
      min-height: 2.4rem;
    }

    @media (max-width: 620px) {
      .marketplace-actions {
        width: 100%;
        align-items: center;
        justify-content: space-between;
      }
    }
  </style>
</BaseLayout>
