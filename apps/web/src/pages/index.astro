---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import CardActions from '../components/CardActions.astro';
import {
  categories,
  lmStudioHubCount,
  lmStudioReadyMcpCount,
  mcpRegistryCount,
  platforms,
  tools,
  type Tool,
} from '../lib/catalog';
import { lmStudioStatus } from '../lib/lmstudio-install';
import { withBase } from '../lib/site-path';

const PAGE_SIZE = 24;

function metadataQuality(tool: Tool): number {
  const knownRuntimeValues = [
    tool.runtime.local,
    tool.runtime.networkRequired,
    tool.runtime.apiKeyRequired,
  ].filter((value) => value !== 'unknown').length;

  return (
    (tool.description.startsWith('No description provided') ? 0 : 1) +
    (tool.categories.some((category) => category !== 'uncategorized') ? 2 : 0) +
    knownRuntimeValues +
    (tool.platforms.length > 0 ? 1 : 0)
  );
}

function freshnessScore(tool: Tool): number {
  const updated = Date.parse(tool.source.updatedAt ?? '') || 0;
  if (!updated) return 0;
  const ageDays = Math.max(0, (Date.now() - updated) / 86_400_000);
  return Math.max(0, 12 - ageDays / 30);
}

function compatibilityScore(tool: Tool): number {
  const status = lmStudioStatus(tool);
  if (status === 'ready') return 16;
  if (status === 'setup-required') return 5;
  return 0;
}

function recommendationScore(tool: Tool): number {
  return (
    Math.log1p(tool.source.downloads ?? 0) * 10 +
    (tool.source.likes ?? 0) * 5 +
    metadataQuality(tool) * 4 +
    freshnessScore(tool) +
    compatibilityScore(tool)
  );
}

const defaultTools = tools.filter((tool) => lmStudioStatus(tool) === 'ready');
const initialTools = [...defaultTools]
  .sort(
    (a, b) =>
      recommendationScore(b) - recommendationScore(a) ||
      a.name.localeCompare(b.name),
  )
  .slice(0, PAGE_SIZE);
const initialVisible = Math.min(PAGE_SIZE, defaultTools.length);
const browseUrl = withBase('browse.json');
---

<BaseLayout>
  <main>
    <section class="site-shell hero">
      <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Your local AI, with more possibilities</div>
      <h1>Small tools.<br /><span class="hero-highlight">Bigger possibilities.</span></h1>
      <p>
        Give LM Studio a few new superpowers. Discover plugins and MCP servers for the things you want to make, find, and do.
      </p>
      <div class="hero-stats" aria-label="Catalogue statistics">
        <div><strong>{lmStudioHubCount.toLocaleString('en-US')}</strong><span>native plugins</span></div>
        <div><strong>{mcpRegistryCount.toLocaleString('en-US')}</strong><span class="stat-help" tabindex="0" aria-describedby="mcp-listed-help">MCPs listed<span class="stat-tooltip" role="tooltip" id="mcp-listed-help">MCP server listings imported from the MCP Registry.</span></span></div>
        <div><strong>{lmStudioReadyMcpCount.toLocaleString('en-US')}</strong><span class="stat-help" tabindex="0" aria-describedby="mcp-ready-help">Ready for LM Studio<span class="stat-tooltip" role="tooltip" id="mcp-ready-help">MCPs with enough published metadata to generate an install configuration. Compatibility has not been individually tested.</span></span></div>
      </div>
    </section>

    <section
      class="site-shell marketplace-panel"
      id="tools"
      aria-labelledby="tools-heading"
      data-browse-url={browseUrl}
      data-page-size={PAGE_SIZE}
    >
      <div class="filters">
        <div class="search-field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
          <input class="search-input" id="tool-search" type="search" placeholder="What do you want to do?" aria-label="Search tools" />
        </div>

        <select class="filter-select" id="type-filter" aria-label="Filter by type">
          <option value="">All types</option>
          <option value="lmstudio-plugin">LM Studio plugins</option>
          <option value="mcp">MCP servers</option>
        </select>

        <select class="filter-select" id="compatibility-filter" aria-label="Filter by LM Studio compatibility">
          <option value="ready" selected>LM Studio ready</option>
          <option value="">All compatibility</option>
          <option value="setup-required">Setup required</option>
          <option value="unknown">Compatibility unknown</option>
        </select>

        <select class="filter-select" id="category-filter" aria-label="Filter by category">
          <option value="">All categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>

        <select class="filter-select" id="platform-filter" aria-label="Filter by platform">
          <option value="">All platforms</option>
          {platforms.map((platform) => <option value={platform}>{platform}</option>)}
        </select>
      </div>

      <div class="marketplace-meta">
        <div>
          <strong id="tools-heading">Find your next tool</strong>
          <span class="source-summary">Built for your local AI workflow.</span>
        </div>
        <div class="marketplace-actions">
          <span id="result-count">{defaultTools.length} {defaultTools.length === 1 ? 'tool' : 'tools'}</span>
          <select class="filter-select sort-select" id="sort-filter" aria-label="Sort tools">
            <option value="recommended">Recommended</option>
            <option value="popular">Popular</option>
            <option value="recent">Recently updated</option>
            <option value="name">Name A–Z</option>
          </select>
        </div>
      </div>

      {(lmStudioHubCount > 0 || mcpRegistryCount > 0) && (
        <details class="catalogue-note">
          <summary>What does “Ready” mean?</summary>
          <p>Native plugins can be added directly to LM Studio. For MCP servers, “Ready” means we can generate a configuration from the published metadata. It is not a security review. Check the tool and its permissions before adding it.</p>
        </details>
      )}

      <div class="tool-grid" id="tool-grid">
        {initialTools.map((tool) => <ToolCard tool={tool} />)}
      </div>

      <div class="empty-state" id="empty-state">
        No tools match those filters yet. Try a broader search.
      </div>

      <div class="load-more-row" id="load-more-row" hidden={defaultTools.length <= PAGE_SIZE}>
        <span id="results-status">Showing {initialVisible} of {defaultTools.length}</span>
        <button class="load-more-button" id="load-more" type="button">Load more</button>
      </div>

      <template id="tool-card-template">
        <article class="tool-card">
          <div class="card-heading">
            <span class="tool-monogram" data-role="monogram" aria-hidden="true"></span>
            <div class="card-kind"><span data-role="type"></span><small data-role="source"></small></div>
            <span class="badge compatibility-badge" data-role="compatibility"></span>
          </div>
          <div class="card-topline" data-role="topline">
          </div>
          <div>
            <h2><a data-role="title"></a></h2>
            <p data-role="description"></p>
          </div>
          <div class="badges" data-role="tags"></div>
          <div class="card-spacer"></div>
          <div class="card-footer">
            <span class="card-meta"><span class="card-author" data-role="author"></span><small data-role="meta"></small></span>
            <CardActions />
          </div>
        </article>
      </template>
    </section>
  </main>

  <script type="module" is:inline>
    const panel = document.querySelector('#tools');
    const searchInput = document.querySelector('#tool-search');
    const typeFilter = document.querySelector('#type-filter');
    const compatibilityFilter = document.querySelector('#compatibility-filter');
    const categoryFilter = document.querySelector('#category-filter');
    const platformFilter = document.querySelector('#platform-filter');
    const sortFilter = document.querySelector('#sort-filter');
    const count = document.querySelector('#result-count');
    const empty = document.querySelector('#empty-state');
    const grid = document.querySelector('#tool-grid');
    const loadMoreRow = document.querySelector('#load-more-row');
    const loadMoreButton = document.querySelector('#load-more');
    const resultsStatus = document.querySelector('#results-status');
    const cardTemplate = document.querySelector('#tool-card-template');
    const pageSize = Number(panel.dataset.pageSize || 48);
    const browseUrl = panel.dataset.browseUrl;

    let allTools = null;
    let currentResults = null;
    let visibleLimit = pageSize;
    let searchTimer = null;

    const sourceLabel = (kind) =>
      kind === 'lmstudio-hub'
        ? 'LM Studio Hub'
        : kind === 'mcp-registry'
          ? 'MCP Registry'
          : kind === 'community'
            ? 'Community'
            : 'Manual listing';

    const compatibilityLabel = (status) =>
      status === 'ready'
        ? 'LM Studio Ready'
        : status === 'setup-required'
          ? 'Setup required'
          : 'Compatibility unknown';

    const addBadge = (container, text, extraClass = '') => {
      const badge = document.createElement('span');
      badge.className = `badge${extraClass ? ` ${extraClass}` : ''}`;
      badge.textContent = text;
      container.append(badge);
    };

    const makeCard = (tool) => {
      const card = cardTemplate.content.firstElementChild.cloneNode(true);
      card.dataset.type = tool.type;
      card.querySelector('[data-role="monogram"]').textContent = tool.name.slice(0, 2).toUpperCase();
      const topline = card.querySelector('[data-role="topline"]');
      card.querySelector('[data-role="type"]').textContent =
        tool.type === 'lmstudio-plugin' ? 'LM Studio Plugin' : 'MCP Server';
      card.querySelector('[data-role="source"]').textContent = sourceLabel(tool.source.kind);

      const compatibilityBadge = card.querySelector('[data-role="compatibility"]');
      compatibilityBadge.textContent = tool.compatibility === 'ready' ? 'Ready' : compatibilityLabel(tool.compatibility);
      if (tool.compatibility === 'ready') compatibilityBadge.classList.add('good');
      if (tool.compatibility === 'setup-required') compatibilityBadge.classList.add('setup');

      if (tool.runtime.local === true) addBadge(topline, 'Fully local', 'good');
      if (tool.runtime.local === false) addBadge(topline, 'Remote');
      if (tool.runtime.apiKeyRequired === false) addBadge(topline, 'No API key', 'good');
      if (tool.risks?.length) addBadge(topline, `⚠ ${tool.risks.length} risk signal${tool.risks.length === 1 ? '' : 's'}`, 'risk');
      topline.hidden = topline.children.length === 0;

      const link = new URL(tool.href, document.baseURI).href;
      const title = card.querySelector('[data-role="title"]');
      title.textContent = tool.name;
      title.href = link;
      card.querySelector('[data-role="description"]').textContent = tool.description;

      const tagContainer = card.querySelector('[data-role="tags"]');
      const visibleCategories = tool.categories.filter((category) => category !== 'uncategorized');
      const displayTags = visibleCategories.length > 0 ? visibleCategories : tool.type === 'mcp' ? tool.tags : [];
      for (const tag of displayTags.slice(0, 4)) addBadge(tagContainer, tag);
      tagContainer.hidden = displayTags.length === 0;

      card.querySelector('[data-role="author"]').textContent = `by ${tool.author}`;
      card.querySelector('[data-role="meta"]').textContent = typeof tool.source.downloads === 'number'
        ? `${tool.source.downloads.toLocaleString('en-US')} downloads`
        : tool.version ? `v${tool.version}` : sourceLabel(tool.source.kind);
      const cardLink = card.querySelector('[data-role="link"]');
      cardLink.href = link;
      cardLink.setAttribute('aria-label', `View details for ${tool.name}`);
      const installLink = card.querySelector('[data-role="install-link"]');
      const installUrl = tool.installUrl?.startsWith('lmstudio://') ? tool.installUrl : null;
      const installLabel = !installUrl ? 'Use details for setup'
        : tool.compatibility === 'setup-required' ? 'Add to LM Studio (setup required)'
        : 'Add to LM Studio';
      installLink.setAttribute('aria-label', `${installLabel}: ${tool.name}`);
      installLink.title = installLabel;
      installLink.dataset.tooltip = installLabel;
      if (installUrl) {
        installLink.href = installUrl;
        installLink.removeAttribute('aria-disabled');
      } else {
        installLink.removeAttribute('href');
        installLink.setAttribute('aria-disabled', 'true');
      }

      return card;
    };

    const buildSearchText = (tool) =>
      [
        tool.name,
        tool.description,
        tool.author,
        sourceLabel(tool.source.kind),
        compatibilityLabel(tool.compatibility),
        tool.type,
        ...tool.categories,
        ...tool.tags,
        ...tool.platforms,
      ]
        .join(' ')
        .toLowerCase();

    const ensureTools = async () => {
      if (allTools) return allTools;
      loadMoreButton.disabled = true;
      loadMoreButton.textContent = 'Loading…';

      const response = await fetch(browseUrl);
      if (!response.ok) throw new Error(`Browse index request failed: ${response.status}`);
      const payload = await response.json();
      if (!Array.isArray(payload.tools)) throw new Error('Browse index is invalid');

      allTools = payload.tools.map((tool) => ({ ...tool, searchText: buildSearchText(tool) }));
      loadMoreButton.disabled = false;
      loadMoreButton.textContent = 'Load more';
      return allTools;
    };

    const values = () => ({
      query: searchInput.value.trim().toLowerCase(),
      type: typeFilter.value,
      compatibility: compatibilityFilter.value,
      category: categoryFilter.value,
      platform: platformFilter.value,
    });

    const matches = (tool, filters) =>
      (!filters.query || tool.searchText.includes(filters.query)) &&
      (!filters.type || tool.type === filters.type) &&
      (!filters.compatibility || tool.compatibility === filters.compatibility) &&
      (!filters.category || tool.categories.includes(filters.category)) &&
      (!filters.platform || tool.platforms.includes(filters.platform));

    const numeric = (value) => Number(value || 0);
    const updatedAt = (tool) => Date.parse(tool.source.updatedAt || '') || 0;
    const byName = (a, b) => a.name.localeCompare(b.name);

    const metadataQuality = (tool) => {
      const knownRuntimeValues = [
        tool.runtime.local,
        tool.runtime.networkRequired,
        tool.runtime.apiKeyRequired,
      ].filter((value) => value !== 'unknown').length;
      return (
        (tool.description.startsWith('No description provided') ? 0 : 1) +
        (tool.categories.some((category) => category !== 'uncategorized') ? 2 : 0) +
        knownRuntimeValues +
        (tool.platforms.length > 0 ? 1 : 0)
      );
    };

    const freshnessScore = (tool) => {
      const updated = updatedAt(tool);
      if (!updated) return 0;
      const ageDays = Math.max(0, (Date.now() - updated) / 86_400_000);
      return Math.max(0, 12 - ageDays / 30);
    };

    const compatibilityScore = (tool) =>
      tool.compatibility === 'ready' ? 16 : tool.compatibility === 'setup-required' ? 5 : 0;

    const recommendationScore = (tool) =>
      Math.log1p(numeric(tool.source.downloads)) * 10 +
      numeric(tool.source.likes) * 5 +
      metadataQuality(tool) * 4 +
      freshnessScore(tool) +
      compatibilityScore(tool);

    const compareTools = (a, b) => {
      const mode = sortFilter.value;
      if (mode === 'name') return byName(a, b);
      if (mode === 'recent') return updatedAt(b) - updatedAt(a) || byName(a, b);
      if (mode === 'popular') {
        return (
          numeric(b.source.downloads) - numeric(a.source.downloads) ||
          numeric(b.source.likes) - numeric(a.source.likes) ||
          byName(a, b)
        );
      }
      return recommendationScore(b) - recommendationScore(a) || byName(a, b);
    };

    const render = () => {
      const results = currentResults ?? [];
      const visible = results.slice(0, visibleLimit);
      grid.replaceChildren(...visible.map(makeCard));

      count.textContent = `${results.length} ${results.length === 1 ? 'tool' : 'tools'}`;
      empty.style.display = results.length ? 'none' : 'block';
      grid.style.display = results.length ? 'grid' : 'none';
      resultsStatus.textContent = `Showing ${visible.length} of ${results.length}`;
      loadMoreRow.hidden = results.length === 0 || visible.length >= results.length;
    };

    const refresh = async (resetLimit = true) => {
      try {
        const catalogue = await ensureTools();
        const filters = values();
        currentResults = catalogue.filter((tool) => matches(tool, filters)).sort(compareTools);
        if (resetLimit) visibleLimit = pageSize;
        render();
      } catch (error) {
        console.error(error);
        loadMoreButton.disabled = false;
        loadMoreButton.textContent = 'Retry';
        resultsStatus.textContent = 'Could not load the full catalogue';
        loadMoreRow.hidden = false;
      }
    };

    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => refresh(true), 140);
    });
    for (const control of [
      typeFilter,
      compatibilityFilter,
      categoryFilter,
      platformFilter,
      sortFilter,
    ]) {
      control.addEventListener('change', () => refresh(true));
    }
    loadMoreButton.addEventListener('click', async () => {
      visibleLimit += pageSize;
      await refresh(false);
    });
  </script>

  <style is:global>
    .catalogue-note {
      margin: 0.9rem 1.1rem 0;
      border: 1px solid rgb(125 211 252 / 16%);
      border-radius: 0.75rem;
      padding: 0.7rem 0.85rem;
      color: var(--muted);
      background: rgb(125 211 252 / 3%);
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .marketplace-actions {
      justify-content: flex-end;
    }

    .sort-select {
      width: auto;
      min-width: 165px;
      min-height: 2.4rem;
    }

    .load-more-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      padding: 0 1.1rem 1.4rem;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .load-more-row[hidden] {
      display: none;
    }

    .load-more-button {
      min-height: 2.5rem;
      border: 1px solid var(--control-border);
      border-radius: 0.7rem;
      padding: 0 1rem;
      color: var(--text);
      background: #09101a;
      cursor: pointer;
    }

    .load-more-button:hover:not(:disabled) {
      border-color: var(--accent-strong);
    }

    .load-more-button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    @media (max-width: 620px) {
      .marketplace-actions {
        width: 100%;
        align-items: center;
        justify-content: space-between;
      }

      .load-more-row {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
