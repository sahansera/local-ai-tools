---
import '../styles/global.css';
import { withBase } from '../lib/site-path';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Local AI Tools',
  description = 'Discover LM Studio-compatible plugins, MCP servers, and other local AI tools.',
} = Astro.props;
const homeHref = withBase();
const browseHref = `${homeHref}#tools`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-shell site-header">
      <a class="brand" href={homeHref}>
        <span class="brand-mark">⌁</span>
        <span>Local AI Tools</span>
      </a>
      <nav class="header-links" aria-label="Primary">
        <a href={browseHref}>Browse</a>
        <a
          class="github-link"
          href="https://github.com/sahansera/local-ai-tools"
          aria-label="Local AI Tools on GitHub"
          title="GitHub repository"
        >
          <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.3 11.3 0 0 0 12 .7Z"
            />
          </svg>
        </a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-shell">
        Independent community project for discovering local-AI tooling. Not affiliated with or endorsed by LM Studio.
      </div>
    </footer>
  </body>
</html>

<style>
  .github-link {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    align-items: center;
    justify-content: center;
    margin: -0.45rem 0;
    border-radius: 0.55rem;
  }

  .github-link:hover {
    background: rgb(255 255 255 / 5%);
  }

  .github-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .site-footer {
    text-align: center;
  }
</style>
