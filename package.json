{
  "name": "local-ai-tools",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "audit:dependencies": "pnpm audit --audit-level=low",
    "build:hub": "pnpm enrich:lmstudio && pnpm build",
    "build:marketplace": "pnpm enrich:lmstudio && pnpm discover:mcp && pnpm build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate:catalog && pnpm build && pnpm verify:web",
    "verify:web": "tsx scripts/verify-web-build.ts",
    "dev": "pnpm --filter @local-ai-tools/web dev",
    "dev:hub": "pnpm enrich:lmstudio && pnpm dev",
    "dev:marketplace": "pnpm enrich:lmstudio && pnpm discover:mcp && pnpm dev",
    "discover:lmstudio": "tsx scripts/discover-lmstudio.ts",
    "discover:mcp": "tsx scripts/discover-mcp-registry.ts",
    "enrich:lmstudio": "pnpm discover:lmstudio && tsx scripts/enrich-lmstudio.ts",
    "generate:catalog": "pnpm --filter @local-ai-tools/catalog generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "search:lmstudio": "tsx scripts/search-lmstudio.ts",
    "test": "tsx --test scripts/*.test.ts && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate:catalog": "pnpm --filter @local-ai-tools/catalog validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
